# tru — root .gitignore
# Stack is explicitly undecided (see design/decisions/ADR-0002-stack-selection.md). The
# language-runtime patterns below are pre-emptive hygiene for whichever stack gets picked —
# their presence is not a stack commitment; do not read them as one.

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Secrets — hackathons run on API keys; never commit one
.env
.env.*
!.env.example
secrets*
*.key
*.pem

# Common language-runtime artifacts (harmless if unused; see note above)
__pycache__/
*.pyc
.venv/
venv/
node_modules/
dist/
build/
.next/
*.log

# Gitignored working directories are governed by their own local .gitignore
# (logs/, scratch/) using the whitelist pattern — see those files, not this one.

# Agent/browser tooling scratch (never part of the project)
.playwright-mcp/

# Python: uv + project-local venv only, never a global install (see CLAUDE.md)
.uv/
.python-version

# Qodo Agent Skills: installed content is generated from skills-lock.json
# (`npx skills add qodo-ai/qodo-skills/skills`). The lockfile is committed so the
# install is reproducible; the expanded skills and editor symlinks are not.
.agents/
.claude/

# Large re-fetchable data. The sample is one range request away (see scripts/verify_apis.sh);
# the full 402 MB Zenodo file must never enter git history.
data/samples/
data/raw/
*.json.gz

# Runtime incident store. Rebuilt by `python replay/engine.py`, which seeds it from
# replay/seed.json — so it is reproducible, and committing it would ship stale demo state
# plus an audit trail that belongs to whoever last ran the replay.
data/*.db
data/*.db-wal
data/*.db-shm

# Runtime incident store. Rebuilt by `python replay/engine.py`, which seeds it from
# replay/seed.json — so it is reproducible, and committing it would ship stale demo state
# plus an audit trail that belongs to whoever last ran the replay.
data/*.db
data/*.db-wal
data/*.db-shm
