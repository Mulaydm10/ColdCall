# ColdCall — copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is a secret; keep them off screen during the demo video too.

# ---- Required: the model TrueForge thinks with -------------------------------------------
# Any provider works; OpenAI is the event's model partner.
OPENAI_API_KEY=
# Model to register. Confirmed present in this build's catalog:
#   gpt-5.6-sol | gpt-5.6-luna | gpt-5.6-terra | gpt-5.5 | gpt-5.4-mini
COLDCALL_MODEL_ID=gpt-5.6-sol

# ---- REQUIRED: Daytona sandbox (see ADR-0005) ---------------------------------------------
#
# The key MUST carry the `write:snapshots` scope. TrueForge registers its sandbox image as a
# Daytona snapshot on first configure; a key without that scope gets a 403, which TrueForge
# reports as the misleading "Daytona rejected the API key — check the credentials". The key
# itself is usually fine — check the scope before assuming otherwise.
#
# Daytona key permissions are FIXED AT CREATION and cannot be edited, so a key missing the
# scope must be recreated: https://app.daytona.io → Keys → Create, with write:snapshots ticked.
#
# One trap, from EXP-0007: standalone TrueForge falls back to a built-in local sandbox ONLY
# when NO Daytona record is stored. A configured-but-broken Daytona provider is therefore
# strictly worse than none — the harness uses it and fails instead of falling back, and there
# is no DELETE endpoint to undo it. Recovery means clearing the row from the SQLite store.
# Do not configure a key you have not verified.
DAYTONA_API_KEY=

# ---- Real integrations (each becomes a remote MCP server) --------------------------------
# Supabase: inventory / telemetry / incident rows, and the quarantine write.
SUPABASE_MCP_URL=
SUPABASE_ACCESS_TOKEN=

# Stripe TEST MODE ONLY. A live key here would let the agent move real money.
STRIPE_SECRET_KEY=sk_test_
STRIPE_MCP_URL=https://mcp.stripe.com

# GitHub: the agent commits the deviation report, which is the audit trail.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=

# ---- Consignee notification --------------------------------------------------------------
# A Slack incoming webhook, or any HTTPS endpoint that accepts a JSON POST.
COLDCALL_NOTIFY_WEBHOOK=

# ---- Local harness ------------------------------------------------------------------------
TRUEFORGE_URL=http://localhost:8790
