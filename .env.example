# ColdCall — copy to .env and fill in. .env is gitignored and must never be committed.
# Every value here is a secret; keep them off screen during the demo video too.

# ---- Required: the model TrueForge thinks with -------------------------------------------
# Any provider works; OpenAI is the event's model partner.
OPENAI_API_KEY=
# Model to register. Confirmed present in this build's catalog:
#   gpt-5.6-sol | gpt-5.6-luna | gpt-5.6-terra | gpt-5.5 | gpt-5.4-mini
COLDCALL_MODEL_ID=gpt-5.6-sol

# ---- Sandbox: OPTIONAL. Leave this blank unless you know you need Daytona ------------------
#
# TrueForge in standalone mode falls back to a BUILT-IN LOCAL SANDBOX when no Daytona provider
# is configured. Verified in the bundle: resolveSandboxProvider() returns the stored Daytona
# provider if one exists, and otherwise — in standalone, where local support is available —
# constructs a LocalSandboxProvider. This machine's boot log confirms local support.
#
# READ THIS BEFORE SETTING A KEY: the fallback only happens when NO Daytona record is stored.
# A configured-but-broken Daytona provider is strictly worse than none, because the harness
# will use it and fail instead of falling back. So do not configure Daytona speculatively.
#
# If you do use Daytona, the key MUST carry the `write:snapshots` scope — TrueForge registers
# its sandbox image as a snapshot, and a key without that scope returns 403, which TrueForge
# reports as the misleading "Daytona rejected the API key". Daytona key permissions are fixed
# at creation and cannot be edited, so a key missing the scope has to be recreated.
DAYTONA_API_KEY=

# ---- Real integrations (each becomes a remote MCP server) --------------------------------
# Supabase: inventory / telemetry / incident rows, and the quarantine write.
SUPABASE_MCP_URL=
SUPABASE_ACCESS_TOKEN=

# Stripe TEST MODE ONLY. A live key here would let the agent move real money.
STRIPE_SECRET_KEY=sk_test_
STRIPE_MCP_URL=https://mcp.stripe.com

# GitHub: the agent commits the deviation report, which is the audit trail.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=

# ---- Consignee notification --------------------------------------------------------------
# A Slack incoming webhook, or any HTTPS endpoint that accepts a JSON POST.
COLDCALL_NOTIFY_WEBHOOK=

# ---- Local harness ------------------------------------------------------------------------
TRUEFORGE_URL=http://localhost:8790
